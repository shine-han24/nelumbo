# ─────────────────────────────────────────────────────────────
# 맞춤법 검사 — 바른한글((주)나라인포테크) API
#
# ⚠ 이 파일에는 절대 실제 키를 적지 마세요. 저장소가 공개돼 있습니다.
#   실제 값은 두 곳에만 둡니다.
#     - 배포:   Vercel → Project Settings → Environment Variables
#     - 로컬:   .env.local  (.gitignore에 걸려 있어 커밋되지 않습니다)
#
# 키가 없으면 앱은 "맞춤법 검사기는 준비 중입니다" 화면을 보여 줍니다.
# 앱은 시작할 때 GET /api/spellcheck 로 설정 여부만 물어보므로,
# 아래 키 하나만 넣으면 별도 플래그 없이 기능이 켜집니다.
# ─────────────────────────────────────────────────────────────

# 서버리스 함수에서만 읽습니다. 브라우저 번들에 들어가지 않습니다.
BARUNHANGUL_API_KEY=

# 선택 — 엔드포인트가 바뀌었을 때만 지정합니다. 비우면 기본값을 씁니다.
BARUNHANGUL_ENDPOINT=

# ⚠ VITE_ 접두사가 붙은 변수는 클라이언트 번들에 그대로 박힙니다.
#   API 키를 여기에 넣으면 브라우저에서 그대로 보입니다. 절대 금지.
