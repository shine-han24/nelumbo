# 맞춤법 검사 — 바른한글((주)나라인포테크) 정식 API 계약 후에 채웁니다.
# 이 값이 없으면 앱은 "맞춤법 검사기는 준비 중입니다" 화면을 보여 줍니다.
#
# Vercel: Project Settings → Environment Variables 에 등록하세요.
# 로컬: 이 파일을 .env.local 로 복사해서 채우면 됩니다. (.env.local 은 커밋되지 않습니다)

# 서버리스 함수에서만 읽습니다. 브라우저에 노출되지 않습니다.
BARUNHANGUL_API_KEY=
BARUNHANGUL_ENDPOINT=

# 프런트엔드 빌드에 주입됩니다. 'on' 이어야 검사기가 목록에 나타납니다.
# VITE_ 접두사가 붙은 값은 번들에 그대로 들어가므로 비밀을 넣지 마세요.
VITE_SPELL_REMOTE=off
